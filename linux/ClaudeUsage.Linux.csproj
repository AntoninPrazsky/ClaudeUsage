<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ClaudeUsage</AssemblyName>
    <RootNamespace>ClaudeUsage</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>1.4.0</Version>
    <Product>Claude Usage</Product>
    <Description>Shows the remaining usage limits of the Claude account signed in to Claude Code.</Description>
    <Authors>Antonín Pražský</Authors>
    <Copyright>Copyright (c) 2026 Antonín Pražský</Copyright>
    <RepositoryUrl>https://github.com/AntoninPrazsky/ClaudeUsage</RepositoryUrl>
  </PropertyGroup>

  <!-- The platform-independent core is shared with the Windows app in the repository root. -->
  <ItemGroup>
    <Compile Include="..\AppInfo.cs" Link="Core\AppInfo.cs" />
    <Compile Include="..\AppSettings.cs" Link="Core\AppSettings.cs" />
    <Compile Include="..\CredentialStore.cs" Link="Core\CredentialStore.cs" />
    <Compile Include="..\Localization.cs" Link="Core\Localization.cs" />
    <Compile Include="..\Models.cs" Link="Core\Models.cs" />
    <Compile Include="..\UsageClient.cs" Link="Core\UsageClient.cs" />
    <Compile Include="..\UsageParser.cs" Link="Core\UsageParser.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="claudeusage.png" LogicalName="claudeusage.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
  </ItemGroup>

</Project>
